import argparse
import math
import string
from pathlib import Path


def load_quadgrams(path):
    quadgrams = {}
    total_count = 0

    with path.open("r", encoding="utf-8") as file:
        for line_number, line in enumerate(file, start=1):
            parts = line.split()
            if not parts:
                continue
            if len(parts) != 2:
                raise ValueError(f"Invalid quadgram data on line {line_number}")

            gram, raw_count = parts
            try:
                count = int(raw_count)
            except ValueError as error:
                raise ValueError(
                    f"Invalid count on line {line_number}: {raw_count!r}"
                ) from error

            if count <= 0:
                raise ValueError(f"Count must be positive on line {line_number}")

            quadgrams[gram.upper()] = count
            total_count += count

    if not quadgrams:
        raise ValueError(f"No quadgram data found in {path}")

    return quadgrams, total_count


def calculate_probability(gram, quadgrams, total_count):
    count = quadgrams.get(gram.upper(), 0.01)
    return math.log10(count / total_count)


def decrypt_with_key(ciphertext, key):
    if len(key) != 26 or any(char not in string.ascii_letters for char in key):
        raise ValueError("The key must contain exactly 26 English letters.")

    alphabet = string.ascii_uppercase
    return "".join(
        key[alphabet.index(char)] if char in alphabet else char
        for char in ciphertext.upper()
    )


def calculate_text_probability(text, quadgrams, total_count):
    letters = "".join(char for char in text.upper() if char in string.ascii_uppercase)
    return sum(
        calculate_probability(letters[index:index + 4], quadgrams, total_count)
        for index in range(len(letters) - 3)
    )


def main():
    parser = argparse.ArgumentParser(
        description="Decrypt text with a substitution key and score it with quadgrams."
    )
    parser.add_argument(
        "quadgrams_file",
        nargs="?",
        type=Path,
        default=Path(__file__).with_name("quadgrams.txt"),
        help="path to quadgrams.txt (default: next to this script)",
    )
    parser.add_argument(
        "--text",
        default="QWERTYUIOP",
        help="ciphertext to decrypt (default: QWERTYUIOP)",
    )
    parser.add_argument(
        "--key",
        default=string.ascii_lowercase,
        help="26-letter substitution key (default: alphabet)",
    )
    args = parser.parse_args()

    quadgrams, total_count = load_quadgrams(args.quadgrams_file)
    print("Total Count =", total_count)

    decrypted_text = decrypt_with_key(args.text, args.key)
    score = calculate_text_probability(decrypted_text, quadgrams, total_count)
    print("ข้อความที่เข้ารหัส:", args.text)
    print("ข้อความที่ถอดรหัส:", decrypted_text)
    print("ค่าความน่าจะเป็น:", score)


if __name__ == "__main__":
    main()
